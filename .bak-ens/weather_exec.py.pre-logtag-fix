"""
modules/weather_exec.py — forward-test executor for the NEAR-LOCK weather engine.

PAPER by default: fills ENTER signals at the quoted ask, persists every event
to weather_positions.jsonl (rehydrated on restart), and settles positions from
the market's own resolution (Gamma umaResolutionStatus == "resolved") — never
from our METAR read. That way the forward test also validates that our
observation feed matches the actual settlement source.

One position per event (city+date): the near-lock trade buys the single
highest-probability bucket, not a ladder.

LIVE mode exists but is double-gated (WEATHER_LIVE=true env AND set_mode) and
routes through polymarket.PolyClient.place_fok — same pattern as
copytrade_exec. Do not arm until the paper forward-test is calibrated
(target: n ≥ 100 settlements, win rate within a few points of model p).
"""

import json
import logging
import os
import threading
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path

import requests

from feeds.poly_weather import fetch_book_asks, fetch_book_bid_c, vwap_for_size

log = logging.getLogger("modules.weather_exec")

POS_LOG = Path(os.getenv("WEATHER_EXEC_LOG", "weather_positions.jsonl"))
# Every live FOK miss is recorded here with the book at the miss instant, so we
# can later tell "market ran away for a reason" (big gap, bucket often loses)
# from "we under-priced by a cent and missed a still-good trade" (small gap).
# The second kind is the argument for loosening the FOK; the first is not.
MISS_LOG = Path(os.getenv("WEATHER_MISS_LOG", "weather_misses.jsonl"))
# After this many consecutive live-FOK misses on the SAME market, stop re-firing
# it for MISS_COOLDOWN_SEC. Seoul low missed 173 times in a day — a thin,
# flickering top-of-book at the price ceiling that a full-size FOK can't fill,
# re-triggered every poll. A real fill clears the streak, so a genuinely
# fillable signal is never permanently abandoned; only the hammering stops.
MISS_COOLDOWN_AFTER = int(os.getenv("WEATHER_MISS_COOLDOWN_AFTER", "3"))
MISS_COOLDOWN_SEC = int(os.getenv("WEATHER_MISS_COOLDOWN_SEC", "1800"))
ENV_ARMED = os.getenv("WEATHER_LIVE", "false").strip().lower() == "true"
# Boot straight into LIVE instead of waiting for the dashboard toggle. Only for
# UNATTENDED hosts: a crash-restart or reboot otherwise comes back PAPER while
# live positions are still open, and a paper executor refuses to close them
# (see _exit_position) — so they'd sit with no dead-exit and no take-profit.
# Still gated on WEATHER_LIVE; this cannot arm live trading on its own.
START_LIVE = os.getenv("WEATHER_START_LIVE", "false").strip().lower() == "true"
STAKE_USD = float(os.getenv("WEATHER_STAKE_USD", "5"))
MAX_OPEN = int(os.getenv("WEATHER_MAX_OPEN", "10"))
# How many times a single market (city|date|kind) may be re-entered after a
# THESIS BREAK stopped us out of an earlier bucket. 0 restores the old
# behaviour (a dead position blocks the market for the rest of the day).
GAMMA_MARKETS = "https://gamma-api.polymarket.com/markets"
# USDC balance immediately BEFORE live trading began. Set this to capture P&L
# from the very first live trade; otherwise the baseline is snapped on first read
# (which would silently exclude any profit already banked).
BASELINE_ENV = os.getenv("WEATHER_LIVE_BASELINE_USD", "").strip()
ACCT_REFRESH_SEC = 60
# Re-run the entry reasoning against open positions on this cadence. Entry is a
# snapshot; the world moves. Warnings fire IMMEDIATELY regardless of cadence.
RECHECK_SEC = float(os.getenv("WEATHER_RECHECK_SEC", "1200"))     # 20 min
# A bid this far below the ask isn't trusted as the position's mark (see
# _mark_open) — looser than the entry gate's MAX_SPREAD_C (10c) since holding
# is a different decision than entering; this only guards against overwriting
# a good mark with a thin/stale outlier, not a fresh entry decision.
MARK_MAX_SPREAD_C = float(os.getenv("WEATHER_MARK_MAX_SPREAD_C", "20"))
# Close once the market has converged this far. The edge is the convergence; the
# last few cents carry the entire downside. 0 disables.
TAKE_PROFIT_BID_C = float(os.getenv("WEATHER_TAKE_PROFIT_BID_C", "90"))
# Keep taking profit AFTER the measurement window has closed? Default no: at
# that point the extreme is fixed and selling below 100c gives away certain
# money. Set true only to restore the old always-on behaviour.
TP_AFTER_WINDOW = os.getenv("WEATHER_TP_AFTER_WINDOW", "false").strip().lower() == "true"
# Take-profit exits default to the same FAK-at-1c sweep used for emergency
# dead-bucket salvage, which is why Warsaw/Milan take-profits filled well
# below their trigger bid (see the weather-lows-never-fill / FOK-vs-FAK
# investigation in memory). ON = true FOK at the current bid for TAKE-PROFIT
# only — fills the full position near the real price or not at all, kill =
# position stays open, retried next cycle. DEAD-EXIT always keeps FAK
# (any salvage beats a guaranteed $0, unlike take-profit's discretionary exit).
TAKE_PROFIT_FOK = os.getenv("WEATHER_TAKE_PROFIT_FOK", "false").strip().lower() == "true"
# After this many consecutive FOK misses on the SAME position, stop trying FOK
# and fall back to the FAK sweep — the point of FOK is a clean exit near the
# real price, but a position that's genuinely stuck (bid keeps re-triggering
# take-profit with never quite enough depth) still needs to actually leave
# before it rides all the way back down to settlement risk. Mirrors the
# buy-side MISS_COOLDOWN_AFTER pattern below. NOT same-cycle — an immediate
# fallback would reproduce the exact bad-price sweep this feature exists to
# avoid, since a partial-depth miss is precisely the case FOK is meant to catch.
TAKE_PROFIT_FOK_MAX_MISSES = int(os.getenv("WEATHER_TAKE_PROFIT_FOK_MAX_MISSES", "3"))
# mirrored from the engine's gates (read from env, not imported, to stay decoupled)
P_MIN = float(os.getenv("WEATHER_P_MIN", "0.92"))
MIN_MAX_AGE_MIN = float(os.getenv("WEATHER_MIN_MAX_AGE_MIN", "120"))
# Don't call a bucket dead on an exact boundary tie. Confirmed 4-for-4 false
# positives on Kalshi's Fahrenheit markets (Austin, Atlanta, Washington DC, San
# Francisco, 2026-07-25/26): the raw extreme is a Celsius-native METAR reading
# converted to Fahrenheit, so it can land fractionally past a whole-degree F
# boundary from conversion rounding alone, with NWS's own official Fahrenheit
# CLI reading landing back inside the bucket. Every genuine break checked so
# far (Shanghai, Tokyo, Chicago, Mexico City — all Celsius-native buckets, no
# conversion step) cleared by a full degree or more, so this costs nothing on
# real deaths; it only filters the conversion-rounding false alarms.
DEAD_EXIT_BUFFER_DEG = float(os.getenv("WEATHER_DEAD_EXIT_BUFFER_DEG", "1.0"))


class WeatherExecutor:
    # log prefix, so shared methods can name the venue they're running for
    LOG_TAG = "weatherexec"
    # Minimum pullback (in the market's unit) from the running extreme before an
    # entry is allowed. 0 disables the gate. See _decline_gate_ok — the evidence
    # for it is much weaker than it first looked, so the DEFAULT IS OFF: this
    # base value is what Polymarket runs, and Poly is deliberately the ungated
    # control arm. Defaulting to 0 also means a missing or mistyped .env line
    # can only ever be a no-op, never a silent change to live trading behaviour.
    DECLINE_GATE_DEG = float(os.getenv("WEATHER_DECLINE_GATE_DEG", "0"))
    # How many times a single market (city|date|kind) may be re-entered after a
    # THESIS BREAK stopped us out of an earlier bucket. 0 disables re-entry —
    # that's the base/Poly default; the Kalshi subclass overrides its own
    # constant independently (see kalshi_weather_exec.py), the same
    # per-venue-override pattern as DECLINE_GATE_DEG above.
    MAX_REENTRIES = int(os.getenv("WEATHER_MAX_REENTRIES", "0"))

    def __init__(self, on_log=None):
        self.on_log = on_log or (lambda i, m: None)
        self.mode = "live" if (ENV_ARMED and START_LIVE) else "paper"
        self.stake_usd = STAKE_USD
        self.open = []            # position dicts
        self.closed = []
        # realized_pnl is NET of taker fees; realized_gross and fees_paid are
        # tracked alongside so the forward test can report both.
        self.session = {"opened": 0, "settled": 0, "wins": 0,
                        "staked_usd": 0.0, "realized_pnl": 0.0,
                        "realized_gross": 0.0, "fees_paid": 0.0}
        # REAL on-chain account tracking (live only) — the ledger's P&L is
        # modeled; USDC is truth. See _refresh_account.
        self._live_baseline = float(BASELINE_ENV) if BASELINE_ENV else None
        self._acct = None
        self._acct_ts = 0.0
        self._lock = threading.Lock()
        # live FOK misses, seeded from the log so the count survives restarts
        self._misses = self._count_misses()
        # per-market miss streaks and cooldown deadlines (in-memory; a restart
        # gives each key one fresh attempt, which is fine — the book may have
        # healed by then). {key: consecutive_misses}, {key: cooldown_until_ts}
        self._miss_streak = {}
        self._cooldown_until = {}
        # markets currently held back by the decline gate, so the "held" line
        # logs once per episode instead of every cycle {key: first_held_utc}
        self._decline_held = {}
        self._rehydrate()

    def _count_misses(self):
        try:
            with open(MISS_LOG) as f:
                return sum(1 for line in f if line.strip())
        except FileNotFoundError:
            return 0
        except Exception:  # noqa: BLE001
            return 0

    # ── persistence ──────────────────────────────────────────────────────────
    @staticmethod
    def _pid(pos):
        """Stable identity for a POSITION — distinct from pos["key"], which is
        the MARKET it trades (city|date|kind) and can be shared by two
        positions after a re-entry (see MAX_REENTRIES). Every position opened
        from here on carries a real "pos_id"; records written before this
        field existed fall back to the market key, which WAS a safe identity
        then because only one open position per market could ever exist.

        This function is the one place that decision lives — every place that
        needs to tell positions apart (removing one from self.open, matching a
        settle record back to the position it closes, rehydrating from the
        ledger) must call this rather than reading pos["key"] directly. A NYC
        low market held two positions overnight on 2026-07-27/28 (a dead
        original plus a re-entry); with identity keyed on the market alone,
        closing either one from a plain `p["key"] != pos["key"]` filter would
        have silently dropped BOTH from self.open, and a restart's rehydrate
        collapsed them to whichever "open" record came last in the file,
        orphaning the other with no way to ever settle it.
        """
        return pos.get("pos_id") or pos["key"]

    def _rehydrate(self):
        if not POS_LOG.exists():
            return
        by_id = {}
        try:
            for line in POS_LOG.read_text().splitlines():
                if not line.strip():
                    continue
                rec = json.loads(line)
                if rec.get("type") == "baseline":
                    # env override wins; else recover the persisted baseline
                    if not BASELINE_ENV:
                        self._live_baseline = rec.get("live_baseline_usd")
                elif rec.get("type") == "open":
                    by_id[self._pid(rec)] = rec
                elif rec.get("type") == "win_add" and self._pid(rec) in by_id:
                    # Kalshi's _maximize_confirmed_win bought MORE of an
                    # already-open position. Without this branch, a restart
                    # would rebuild the position from its original "open"
                    # record alone — silently reverting shares/cost_usd to
                    # pre-add and losing the _win_adds count, letting the cap
                    # be exceeded on the next add after every restart.
                    pos = by_id[self._pid(rec)]
                    pos["shares"] = round(pos.get("shares", 0.0) + rec.get("filled", 0.0), 6)
                    pos["cost_usd"] = round(pos.get("cost_usd", 0.0) + rec.get("cost_usd", 0.0), 2)
                    pos["_win_adds"] = rec.get("add_num", pos.get("_win_adds", 0))
                elif rec.get("type") == "settle" and self._pid(rec) in by_id:
                    pos = by_id.pop(self._pid(rec))
                    # backfill net/gross/fee for pre-fee-accounting settle records
                    gross = rec.get("gross_pnl")
                    if gross is None:
                        gross = rec.get("pnl_usd", 0.0)   # old records stored gross here
                    # legacy records written before fee tracking existed — Poly's
                    # real fee is $0 (verified against actual fills), not the old
                    # 5% model estimate this used to backfill with.
                    fee = rec.get("fee_usd")
                    if fee is None:
                        fee = 0.0
                    net = round(gross - fee, 2)
                    self.closed.append({**pos, **rec, "gross_pnl": gross,
                                        "fee_usd": fee, "pnl_usd": net})
                    self.session["settled"] += 1
                    self.session["wins"] += 1 if rec.get("won") else 0
                    # keep the calibration counters correct across restarts:
                    # early exits don't reveal if the bucket was right; only
                    # positions HELD to resolution count toward win_rate_held.
                    if rec.get("closed_early"):
                        self.session["early_exits"] = self.session.get("early_exits", 0) + 1
                    elif rec.get("won"):
                        self.session["wins_held"] = self.session.get("wins_held", 0) + 1
                    self.session["realized_pnl"] += net
                    self.session["realized_gross"] += gross
                    self.session["fees_paid"] += fee
        except Exception as e:  # noqa: BLE001
            self.on_log("✗", f"[weatherexec] rehydrate failed: {e}")
            return
        self.open = list(by_id.values())
        self.session["opened"] = self.session["settled"] + len(self.open)
        self.session["staked_usd"] = round(
            sum(p.get("cost_usd", 0.0) for p in self.open), 2)
        self.closed = self.closed[-200:]
        if self.open or self.closed:
            self.on_log("→", f"[weatherexec] recovered {len(self.open)} open / "
                             f"{self.session['settled']} settled from {POS_LOG}")

    def _persist(self, rec):
        try:
            with open(POS_LOG, "a") as f:
                f.write(json.dumps(rec) + "\n")
        except Exception as e:  # noqa: BLE001
            log.warning("persist failed: %s", e)

    # ── mode control ─────────────────────────────────────────────────────────
    def set_mode(self, mode):
        mode = (mode or "paper").lower()
        if mode == "live" and not ENV_ARMED:
            self.on_log("!", "[weatherexec] LIVE requested but WEATHER_LIVE!=true — staying PAPER")
            mode = "paper"
        if mode != self.mode:
            self.mode = mode
            self.on_log("◆", f"[weatherexec] mode → {mode.upper()}")

    @property
    def is_live(self):
        return self.mode == "live" and ENV_ARMED

    # ── entries (called by WeatherEngine.refresh) ────────────────────────────
    def on_refresh(self, rows):
        self._mark_open(rows)           # mark positions to market before anything else
        self._recheck_open(rows)        # is the thesis we bought on still true?
        self._watch_decline_confirm(rows)  # shadow-measure the wait-for-pullback rule
        self._close_dead(rows)          # bail out of provably-lost buckets
        self._take_profit(rows)         # and out of ones the market already agrees with
        self._maximize_confirmed_win(rows)  # and buy more of ones already DECIDED won
        for row in rows:
            entry = row.get("entry")
            if not entry:
                continue
            self._consider(entry)

    # ── maximize confirmed wins ──────────────────────────────────────────────
    # Once the station's measurement window has closed (_window_closed) the
    # daily extreme cannot change — only the settlement print is outstanding.
    # If our own read already shows the position inside its bucket at that
    # point, buying more below WIN_ADD_MAX_ASK_C is no longer a weather bet;
    # it's a bet that the venue correctly processes data that already exists.
    # Close to risk-free but not literally zero: METAR-vs-CLI has disagreed
    # with our read 3 times this week (see _cli_crosscheck), always so far in
    # a direction that would have helped, never hurt — but "so far" is 3
    # cases. Capped in size (normal per-trade stake, never sized up) and count
    # for that residual reason.
    #
    # Deliberately NOT applied to still-open positions that merely "look"
    # confirmed: Atlanta 2026-07-26 entered on a 2° pullback and 97.7% model
    # confidence — the strongest lock signal in the dataset — and still lost
    # the full stake while the window was open. Only a closed window turns
    # "looks decided" into "is decided".
    #
    # Verified empirically 2026-07-28 that this generalizes across venues:
    # Kalshi's close_time trails local midnight by exactly 1h; Polymarket's
    # Istanbul and London markets both stopped accepting orders ~42min after
    # their own local midnight (closedTime vs station local-day rollover,
    # checked against real settled markets) — so both venues keep trading
    # open a while past the window closing, this is not Kalshi-specific.
    MAXIMIZE_WINS = os.getenv("WEATHER_MAXIMIZE_WINS", "true").strip().lower() == "true"
    MAX_WIN_ADDS = int(os.getenv("WEATHER_MAX_WIN_ADDS", "3"))
    WIN_ADD_MAX_ASK_C = float(os.getenv("WEATHER_WIN_ADD_MAX_ASK_C", "97"))

    def _maximize_confirmed_win(self, rows):
        if not self.MAXIMIZE_WINS or not self.is_live:
            return
        by_key = {f"{r['city']}|{r['date']}|{r['kind']}": r for r in rows}
        with self._lock:
            open_pos = list(self.open)
        for pos in open_pos:
            if pos.get("dead_since"):
                continue                        # DEAD-EXIT handles this side
            row = by_key.get(pos["key"])
            if not row or not self._window_closed(pos, row):
                continue                        # still live — Atlanta proved
                                                 # "looks confirmed" isn't; do not add
            ext = row.get("ext_c")
            if ext is None:
                continue
            r_ext = round(ext)
            lo, hi = pos.get("lo"), pos.get("hi")
            confirmed_win = (lo is None or r_ext >= lo) and (hi is None or r_ext <= hi)
            if not confirmed_win:
                continue                        # window closed but this is a LOSS
            bucket = next((b for b in row.get("buckets", [])
                           if b.get("label") == pos.get("label")), {})
            ask_c = bucket.get("ask_c")
            if ask_c is None or ask_c <= 0 or ask_c > self.WIN_ADD_MAX_ASK_C:
                continue                        # no real edge left, or no live quote
            adds = pos.get("_win_adds", 0)
            if adds >= self.MAX_WIN_ADDS:
                continue
            shares = max(1, round(self.stake_usd / (ask_c / 100.0)))
            filled, fill_c = self._place_live_fak(pos["token_yes"], ask_c, shares, pos.get("neg_risk"))
            if filled <= 0:
                continue
            cost = round(filled * fill_c / 100.0 + self._entry_fee_usd(filled, fill_c), 2)
            rec = {"type": "win_add", "key": pos["key"], "pos_id": self._pid(pos),
                   "filled": filled, "fill_c": fill_c, "cost_usd": cost,
                   "add_num": adds + 1, "ts": datetime.now(timezone.utc).isoformat()}
            with self._lock:
                pos["shares"] = round(pos.get("shares", 0.0) + filled, 6)
                pos["cost_usd"] = round(pos.get("cost_usd", 0.0) + cost, 2)
                pos["_win_adds"] = adds + 1
                self.session["staked_usd"] = round(self.session["staked_usd"] + cost, 2)
            self._persist(rec)
            self.on_log("◆", f"[{self.LOG_TAG}] WIN-ADD {pos['city']} {pos['label']} — "
                             f"+{filled:.2f} sh @ {fill_c:.0f}c (add {adds + 1}/"
                             f"{self.MAX_WIN_ADDS}), outcome confirmed, window closed")

    # ── mark to market ───────────────────────────────────────────────────────
    def _mark_open(self, rows):
        """Stamp each open position with the current BID — what it's actually
        worth right now, not what we paid.

        Valuing open positions at cost silently reports a dead position as if it
        still held its purchase value: with Miami worthless the dashboard showed
        real P&L +$1.55 when the truth was -$6.50. Equity must mark to market.

        BUT a raw bid isn't automatically trustworthy either: NYC's 74-75F bucket
        went bid=13/ask=80 (67c spread) while nothing else about the position
        changed — a thin, stale lowball resting order, not the market repricing
        the position. This is the OPPOSITE signature of actually going dead
        (ask crashes toward 0 too, so spread stays tight) — so a wide spread
        with the ask still healthy means "don't trust this number", and we keep
        the last credible mark rather than overwrite it with noise. A genuinely
        dead bucket still marks down correctly, since its ask crashes with it.
        """
        by_key = {f"{r['city']}|{r['date']}|{r['kind']}": r for r in rows}
        with self._lock:
            for pos in self.open:
                row = by_key.get(pos["key"])
                if not row:
                    continue
                b = next((x for x in row.get("buckets", [])
                          if x.get("label") == pos.get("label")), None)
                if b is None or b.get("bid_c") is None:
                    continue
                ask_c = b.get("ask_c")
                spread = (ask_c - b["bid_c"]) if ask_c is not None else None
                if spread is not None and spread > MARK_MAX_SPREAD_C:
                    pos["mark_stale"] = True
                    continue
                pos["mark_stale"] = False
                pos["mark_c"] = b["bid_c"]

    # ── position health re-check ─────────────────────────────────────────────
    def _recheck_open(self, rows):
        """Re-run the ENTRY reasoning (thermometer -> lock -> probability) against
        every open position.

        Entry is a snapshot and the world moves. BA and Miami both went from a
        confident buy to worthless inside an hour as the temperature resumed
        climbing — and by the time they were arithmetically dead, every bid had
        already gone. Waiting for the dead-exit is waiting too long: it fires
        when the position is provably lost, which is exactly when nobody will
        buy it. This re-reads the thermometer each refresh so a broken thesis is
        visible while there is still a bid to sell into.

        Health is logged on RECHECK_SEC cadence, but a BREAK warns immediately.
        """
        by_key = {f"{r['city']}|{r['date']}|{r['kind']}": r for r in rows}
        now = time.time()
        with self._lock:
            open_pos = list(self.open)
        for pos in open_pos:
            row = by_key.get(pos["key"])
            if not row:
                continue
            kind = pos.get("kind", "high")
            ext, age = row.get("ext_c"), row.get("ext_age_min")
            bucket = next((b for b in row.get("buckets", [])
                           if b.get("label") == pos.get("label")), None)
            p_now = (bucket or {}).get("p")
            lo, hi = pos.get("lo"), pos.get("hi")
            # how many degrees of room before the bucket dies
            headroom = None
            if ext is not None:
                if kind == "high" and hi is not None:
                    headroom = hi - ext
                elif kind == "low" and lo is not None:
                    headroom = ext - lo
            p_entry = pos.get("model_p")
            locked = (age is not None and age >= MIN_MAX_AGE_MIN)
            reasons = []
            if p_now is not None and p_now < P_MIN:
                reasons.append(f"confidence {p_now:.2f} < entry bar {P_MIN}")
            if not locked and age is not None:
                reasons.append(f"lock BROKEN — new extreme {age:.0f}min ago, moving again")
            # headroom == 0 is NORMAL for an exact-value bucket (lo==hi): sitting
            # on your number is how you win it (Manila did exactly that). Only a
            # NEGATIVE headroom means the extreme has passed us and it's dead.
            if headroom is not None and headroom < 0:
                reasons.append(f"extreme passed the bucket ({headroom:+.0f}°) — dead")
            health = {
                "p_now": round(p_now, 4) if p_now is not None else None,
                "p_entry": p_entry,
                "p_delta": (round(p_now - p_entry, 4)
                            if (p_now is not None and p_entry is not None) else None),
                "ext_now": ext, "headroom": headroom,
                "age_min": round(age, 1) if age is not None else None,
                "locked": locked, "mark_c": pos.get("mark_c"),
                "breaks": reasons, "checked": now,
            }
            pos["health"] = health
            broke = bool(reasons)
            was_broken = pos.get("_broken", False)
            due = (now - pos.get("_recheck_ts", 0)) >= RECHECK_SEC
            if broke and not was_broken:
                # fire the moment it breaks — a bid may still exist right now
                mk = pos.get("mark_c")
                self.on_log("!", f"[weatherexec] ⚠ THESIS BREAK {pos['city']} {pos['label']}: "
                                 f"{'; '.join(reasons)} | bid {mk if mk is not None else '?'}c "
                                 f"vs entry {pos['entry_c']:.0f}c — exit window is NOW, "
                                 f"dead-exit will be too late")
                pos["_recheck_ts"] = now
            elif due:
                self.on_log("→", f"[weatherexec] recheck {pos['city']} {pos['label']}: "
                                 f"max {ext}° headroom {headroom if headroom is not None else '?'}° "
                                 f"| p {p_entry}→{health['p_now']} | "
                                 f"{'locked' if locked else 'UNLOCKED'} {health['age_min']}min "
                                 f"| bid {pos.get('mark_c')}c vs entry {pos['entry_c']:.0f}c")
                pos["_recheck_ts"] = now
            pos["_broken"] = broke

    # ── dead-position exit ───────────────────────────────────────────────────
    def _close_dead(self, rows):
        """Exit buckets that CANNOT win any more.

        A daily extreme is monotonic: the max only rises, the min only falls.
        So once the observed max exceeds a high-bucket's ceiling (or the observed
        min drops below a low-bucket's floor), that bucket is arithmetically dead
        — it will settle 0. Riding it to settlement burns the slot and forfeits
        whatever bid is still standing. (Live BA 23°C died this way: 24°C printed
        and the bids vanished within minutes. Salvage beats hope.)
        """
        by_key = {f"{r['city']}|{r['date']}|{r['kind']}": r for r in rows}
        with self._lock:
            open_pos = list(self.open)
        for pos in open_pos:
            row = by_key.get(pos["key"])
            if not row or row.get("ext_c") is None:
                continue
            ext, lo, hi = row["ext_c"], pos.get("lo"), pos.get("hi")
            kind = pos.get("kind", "high")
            # ── round to the grain the market actually settles on ────────────
            # Bucket edges are whole degrees and so is the settlement number.
            # Our observed extreme is NOT: US stations measure in °F, encode to
            # °C-tenths for METAR, and we convert back — a round trip that lands
            # on 71.96 or 82.04 where the true reading was 72 or 82. Comparing
            # that raw value against an integer edge is a category error, and it
            # sold three winners on 2026-07-25 (Dallas 98, Washington DC 82, San
            # Francisco 71 — each settled EXACTLY at its ceiling per the NWS CLI
            # product, which is where a few hundredths flips the decision).
            # bucket_prob() has always rounded before doing its maths; this makes
            # the exit agree with the model instead of contradicting it.
            ext_s = round(ext)
            # >= not >: a clean 1-degree break (Shanghai, Mexico City, Atlanta —
            # all genuine) must still trigger.
            if kind == "high" and hi is not None and ext_s - hi >= DEAD_EXIT_BUFFER_DEG:
                self._exit_dead(pos, row, f"max {ext_s}° (obs {ext:.2f}°) > bucket "
                                          f"ceiling {hi}° "
                                          f"(+{DEAD_EXIT_BUFFER_DEG}° buffer cleared)")
            elif kind == "low" and lo is not None and lo - ext_s >= DEAD_EXIT_BUFFER_DEG:
                self._exit_dead(pos, row, f"min {ext_s}° (obs {ext:.2f}°) < bucket "
                                          f"floor {lo}° "
                                          f"(-{DEAD_EXIT_BUFFER_DEG}° buffer cleared)")

    # ── take profit once the market has converged ────────────────────────────
    @staticmethod
    def _window_closed(pos, row):
        """Has the station's local day moved past this market's date?

        True means the daily extreme can no longer change — the market is
        waiting only on the settlement source to publish. Defensive: an
        unparseable or missing date returns False, so a bad read can never
        silently disable take-profit on a live, still-uncertain position.
        """
        sld, mkt = row.get("station_local_date"), pos.get("date")
        if not sld or not mkt:
            return False
        try:
            return (datetime.fromisoformat(sld).date()
                    > datetime.fromisoformat(mkt).date())
        except (TypeError, ValueError):
            return False

    def _take_profit(self, rows):
        """Close positions the market has already repriced to (near) certainty.

        The edge is in the CONVERGENCE, not the settlement. We buy a lagging
        bucket and get paid when the market catches up — after that the trade is
        over, but holding to settlement silently swaps a good asymmetry for a
        terrible one. Istanbul: bought 82c, market moved to 91c (9 of the 18c
        captured); holding the last 9c risks the whole 91c — a 10:1 bet to earn
        pennies. Chengdu at 99c bid has literally ~1c left to win and $3.80 to lose.

        This is a VARIANCE trade, not free money: if the book is fair, selling at
        the bid gives up ~half the spread versus holding. With a small bankroll,
        a demonstrably overconfident model, and ~2.7 wins needed per loss, that
        is a price worth paying.
        """
        if TAKE_PROFIT_BID_C <= 0:
            return
        by_key = {f"{r['city']}|{r['date']}|{r['kind']}": r for r in rows}
        with self._lock:
            open_pos = list(self.open)
        for pos in open_pos:
            row = by_key.get(pos["key"])
            if not row:
                continue
            # ── the window has closed: stop discounting a risk that is gone ──
            # Everything above assumes the outcome is still uncertain. Once the
            # station's local day has rolled past this market's date, the
            # extreme is FIXED and only the settlement print is outstanding —
            # so every cent below 100 that we accept here is a pure giveaway.
            # NYC 2026-07-27: window shut at midnight with the low locked at
            # 68.0F inside a 67-68F bucket, and trading stayed open another
            # hour with the bid at 88c. Selling would have handed over ~$0.90
            # of a $1.25 win to avoid nothing at all.
            if not TP_AFTER_WINDOW and self._window_closed(pos, row):
                if not pos.get("_tp_window_logged"):
                    pos["_tp_window_logged"] = True
                    self.on_log("→", f"[{self.LOG_TAG}] TP off {pos['city']} "
                                     f"{pos['label']} — measurement window closed "
                                     f"({row.get('station_local_date')} > {pos['date']}); "
                                     f"outcome fixed, holding to settlement")
                continue
            bid = pos.get("mark_c")
            if bid is None or bid < TAKE_PROFIT_BID_C:
                continue
            entry = pos.get("entry_c") or 0
            captured = bid - entry
            if captured <= 0:                     # never "take profit" at a loss
                continue
            upside, risk = 100 - bid, bid
            self._exit_position(
                pos, row, won=True, tag="TAKE-PROFIT",
                reason=(f"bid {bid:.0f}c >= {TAKE_PROFIT_BID_C:.0f}c — converged "
                        f"({captured:+.0f}c of {100-entry:.0f}c captured); holding "
                        f"risks {risk:.0f}c to win {upside:.0f}c"))

    def _exit_dead(self, pos, row, reason):
        """Sell out of a dead bucket (or write it off when nothing bids).

        Stamp it dead FIRST. A daily extreme is monotonic, so once the reading
        has passed the bucket this position can never recover — it is awaiting
        settlement, not in play. When the sale fails for want of a bid it stays
        in self.open, and without this stamp it goes on reserving the market
        slot: NYC 2026-07-27 held a worthless 69–70°F low with no bid while the
        67–68°F bucket showed a +27c edge on the same market, and the bot
        silently skipped it for hours. See _consider.
        """
        pos["dead_since"] = pos.get("dead_since") or datetime.now(timezone.utc).isoformat()
        pos["dead_reason"] = reason
        self._exit_position(pos, row, won=False, tag="DEAD-EXIT", reason=reason)

    def _exit_position(self, pos, row, won, tag, reason):
        """Shared exit: sell into whatever bids exist and book the REAL proceeds."""
        bucket = next((b for b in row.get("buckets", [])
                       if b.get("label") == pos.get("label")), {})
        bid_c = bucket.get("bid_c") or 0.0
        sold, proceeds, fill_c = 0.0, 0.0, None
        # A LIVE position holds real shares. It may only be closed by a real sale
        # (or by real settlement). If the executor has since been flipped to
        # paper, the live-sell branch below is skipped — and paper-marking it out
        # would book profit that does not exist while the shares sit untouched in
        # the wallet. That happened: Chengdu+Istanbul booked a phantom +$1.96
        # against zero USDC movement. Refuse, and say so.
        if pos.get("mode") == "live" and not self.is_live:
            if not pos.get("_exit_blocked"):
                pos["_exit_blocked"] = True
                self.on_log("!", f"[weatherexec] {tag} SKIPPED {pos['city']} {pos['label']} — "
                                 f"live position, executor is PAPER. Not booking a "
                                 f"simulated exit against real shares. Arm live to "
                                 f"sell, or close it manually. ({reason})")
            return
        if pos.get("mode") == "live" and self.is_live:
            try:
                import polymarket
                client = self._poly()
                fee = polymarket.fetch_live_fee_bps(pos["token_yes"]) or 0
                stuck = pos.get("_tp_fok_misses", 0) >= TAKE_PROFIT_FOK_MAX_MISSES
                if tag == "TAKE-PROFIT" and TAKE_PROFIT_FOK and bid_c > 0 and not stuck:
                    # True FOK at the current bid — full size near this price,
                    # or nothing. A kill leaves the position untouched; the
                    # normal take-profit check will just try again next cycle.
                    sold = client.place_sell_fok_at(
                        pos["token_yes"], bid_c, float(pos["shares"]), fee,
                        neg_risk=pos.get("neg_risk"))
                    if sold <= 0:
                        n = pos["_tp_fok_misses"] = pos.get("_tp_fok_misses", 0) + 1
                        if n >= TAKE_PROFIT_FOK_MAX_MISSES:
                            self.on_log("!", f"[weatherexec] TAKE-PROFIT FOK missed "
                                             f"{pos['city']} {pos['label']} @ {bid_c:.0f}c "
                                             f"{n}x — falling back to FAK from here")
                        else:
                            self.on_log("→", f"[weatherexec] TAKE-PROFIT FOK missed "
                                             f"{pos['city']} {pos['label']} @ {bid_c:.0f}c "
                                             f"({n}/{TAKE_PROFIT_FOK_MAX_MISSES}) — holding for next check")
                        return               # position stays open, untouched
                else:
                    if stuck and tag == "TAKE-PROFIT" and TAKE_PROFIT_FOK:
                        self.on_log("→", f"[weatherexec] TAKE-PROFIT {pos['city']} "
                                         f"{pos['label']} — using FAK (stuck after "
                                         f"{pos['_tp_fok_misses']} FOK misses)")
                    sold = client.place_sell_fok(pos["token_yes"], float(pos["shares"]),
                                                 fee, neg_risk=pos.get("neg_risk"))
                # Use the REAL USDC received, not shares x a cached book quote.
                # The quote can be badly stale in our favour: a dead Shenzhen
                # bucket swept stale 90c bids for $6.30 while the cached bid
                # implied $5.54 (booked +$1.13 against a real +$1.89).
                real = getattr(client, "_last_sell_proceeds_usd", None)
                fill_c = getattr(client, "_last_fill_price_cents", None)
                proceeds = round(real if real is not None else sold * bid_c / 100.0, 2)
            except Exception as e:  # noqa: BLE001
                self.on_log("✗", f"[weatherexec] {tag} sell failed {pos['city']}: {e}")
                return                       # keep the position; retry next refresh
            if sold <= 0:
                # A completely dry book (no bids anywhere) is not the same as
                # "nothing to salvage, safe to write off" — the shares are
                # still REALLY held. Closing here anyway would silently mark
                # a naked position settled while it sits unsold in the wallet
                # (caught live 2026-07-25: Chicago + Mexico City both logged
                # "STILL NAKED on remainder" from place_sell_fok's own retries,
                # yet still got booked as a closed $0-salvage loss). Leave it
                # open — _close_dead / _take_profit will retry the sell next
                # cycle, and poll()'s Gamma check is the final backstop if it
                # never manages to sell before real settlement.
                self.on_log("!", f"[weatherexec] {tag} {pos['city']} {pos['label']} — "
                                 f"sell found nothing to fill, still holding "
                                 f"{pos['shares']:.2f} sh naked; retrying next cycle")
                return
        else:
            sold = float(pos["shares"])          # paper: mark out at the bid
            proceeds = round(sold * bid_c / 100.0, 2)
        # A FOK/FAK fill can be partial (thin book, or the exchange filling less
        # than a "full-or-nothing" request despite the docstring's assumption —
        # observed live on Istanbul 2026-07-24: asked to sell 10, got 9). Closing
        # the position here regardless would silently abandon the unsold
        # remainder — no longer tracked, no longer retried, real shares left
        # sitting in the wallet. Accumulate across partial fills and only book
        # the position closed once the sellable remainder is gone.
        remaining = round(pos["shares"] - sold, 6)
        if sold > 0 and remaining >= 1.0:
            pos["_exit_sold_shares"] = pos.get("_exit_sold_shares", 0.0) + sold
            pos["_exit_proceeds_usd"] = round(pos.get("_exit_proceeds_usd", 0.0) + proceeds, 2)
            pos["shares"] = remaining
            self.on_log("→", f"[weatherexec] {tag} {pos['city']} {pos['label']} — partial fill "
                             f"{sold:.2f} sh (${proceeds:.2f}); {remaining:.2f} sh still held, "
                             f"retrying next cycle")
            return                            # keep the position open for the remainder
        sold = pos.get("_exit_sold_shares", 0.0) + sold
        proceeds = round(pos.get("_exit_proceeds_usd", 0.0) + proceeds, 2)
        pnl = round(proceeds - pos.get("cost_usd", 0.0), 2)
        rec = {"type": "settle", "key": pos["key"], "pos_id": self._pid(pos), "won": won,
               "mode": pos.get("mode"),
               "closed_early": True, "exit": tag, "reason": reason,
               "salvage_usd": proceeds, "sold_shares": round(sold, 6),
               "sold_at_c": round(fill_c, 2) if fill_c is not None else None,
               "gross_pnl": pnl, "fee_usd": 0.0, "pnl_usd": pnl,
               "settled": datetime.now(timezone.utc).isoformat()}
        with self._lock:
            self.open = [p for p in self.open if self._pid(p) != self._pid(pos)]
            self.closed.append({**pos, **rec})
            self.closed = self.closed[-200:]
            self.session["settled"] += 1
            self.session["wins"] += 1 if won else 0
            # early exits never reveal whether the BUCKET was right, so they must
            # not be counted as evidence for/against the model's calibration
            self.session["early_exits"] = self.session.get("early_exits", 0) + 1
            self.session["realized_pnl"] = round(self.session["realized_pnl"] + pnl, 2)
            self.session["realized_gross"] = round(self.session["realized_gross"] + pnl, 2)
            self.session["staked_usd"] = round(
                max(0.0, self.session["staked_usd"] - pos.get("cost_usd", 0.0)), 2)
        self._persist(rec)
        self.on_log("✅" if pnl >= 0 else "✗",
                    f"[weatherexec] {tag} {pos['city']} {pos['label']} — {reason}; "
                    f"got ${proceeds:.2f} of ${pos.get('cost_usd',0):.2f} ({pnl:+.2f})")

    def _consider(self, entry):
        key = f"{entry['city']}|{entry['date']}|{entry.get('kind', 'high')}"
        with self._lock:
            if len(self.open) >= MAX_OPEN:
                return
            # ── one LIVE position per market, but a dead one frees the slot ──
            # A position whose bucket the reading has already passed cannot
            # recover (the daily extreme only moves one way). Letting it keep
            # the market reserved cost us a real trade: NYC 2026-07-27 sat on a
            # worthless 69–70°F low with no bid to sell into, while 67–68°F on
            # the SAME market showed +27c. Only a still-live position blocks.
            held = [p for p in self.open if p["key"] == key]
            if any(not p.get("dead_since") for p in held):
                return
            # Closed positions still block — with one exception. A market we
            # took profit on or that settled naturally is finished for the day;
            # re-entering it would be double-dipping. A market we were stopped
            # out of on a THESIS BREAK is a different bucket on a live market,
            # which is exactly the case worth re-examining.
            done = [c for c in self.closed if c.get("key") == key]
            if any(c.get("exit") != "DEAD-EXIT" for c in done):
                return
            # Cap replacements. Without this, a station falling through bucket
            # after bucket would have us buy each one on the way down — the
            # uncapped-re-entry mistake that stacked one arb 9 times and
            # orphaned the legs. One replacement per market per day by default.
            if len(held) + len(done) > self.MAX_REENTRIES:
                return
            # cooling down after repeated misses on this market? skip re-firing.
            until = self._cooldown_until.get(key, 0)
            if until and time.time() < until:
                return
            if until:  # window elapsed — clear it and give this key a fresh try
                self._cooldown_until.pop(key, None)
                self._miss_streak.pop(key, None)
        if not self._decline_gate_ok(entry):
            return
        ask_c = entry["ask_c"]
        if ask_c is None or ask_c <= 0:
            return
        # Prefer the size the engine actually verified depth for on the real
        # book; fall back to stake/price only if the book wasn't confirmed.
        shares = entry.get("shares_planned") or max(
            entry.get("min_size") or 5, round(self.stake_usd / (ask_c / 100.0)))
        filled_c = ask_c          # paper fills at the (book-confirmed) ask
        mode = "paper"
        if self.is_live:
            # Send the LIMIT that clears the worst level we'd touch (ask_c is the
            # VWAP we expect to pay — using it as the limit under-prices the FOK
            # and gets it killed).
            limit_c = entry.get("limit_c") or ask_c
            filled, fill_c = self._place_live(entry["token_yes"], limit_c, shares,
                                              entry.get("neg_risk"))
            if filled <= 0:
                self._record_miss(entry, limit_c, shares)
                n = self._miss_streak.get(key, 0) + 1
                self._miss_streak[key] = n
                if n >= MISS_COOLDOWN_AFTER:
                    self._cooldown_until[key] = time.time() + MISS_COOLDOWN_SEC
                    self.on_log("!", f"[weatherexec] {key} cooling down "
                                f"{MISS_COOLDOWN_SEC // 60}min after {n} misses")
                return
            shares, mode = filled, "live"
            self._miss_streak.pop(key, None)   # a real fill clears the streak
            # record the ACTUAL average fill price the exchange gave us (a FOK
            # often fills below the limit), not the limit ask — otherwise live
            # cost/P&L is mis-stated. fill_c is None only if the resp lacked amounts.
            if fill_c is not None and fill_c > 0:
                filled_c = round(fill_c, 2)
        # Real entry-side taker fees (Kalshi charges one; Polymarket's real
        # trades showed zero — verified against actual fills 2026-07-26) belong
        # in the cost basis, not just the exit-side fee. Omitting it overstated
        # every live Kalshi P&L by the entry fee (~$0.23 on a real $8 trade,
        # ~5% of the reported profit). _entry_fee_usd is a no-op unless overridden.
        cost = round(shares * filled_c / 100.0 + self._entry_fee_usd(shares, filled_c), 2)
        pos = {
            "type": "open",
            # pos_id, not "key", is this position's identity — see _pid.
            # "key" stays the MARKET (city|date|kind) it trades, unchanged and
            # still what row-matching and the re-entry cap key off.
            "pos_id": uuid.uuid4().hex,
            "key": key, "mode": mode, "kind": entry.get("kind", "high"),
            "city": entry["city"], "date": entry["date"], "station": entry["station"],
            "label": entry["label"], "condition_id": entry["condition_id"],
            "token_yes": entry["token_yes"], "slug": entry["slug"],
            "lo": entry.get("lo"), "hi": entry.get("hi"),
            "neg_risk": entry.get("neg_risk"),
            "entry_c": filled_c, "shares": shares, "cost_usd": cost,
            "model_p": entry["p"], "edge_c": entry["edge_c"],
            "opened": datetime.now(timezone.utc).isoformat(),
            # ── decline-at-entry measurement (shadow only, gates nothing) ──
            # Backtest over all 26 settled high entries (2026-07-26): every
            # loser entered while the reading still SAT at its running extreme
            # (decline 0.0); every entry made after a ≥1° pullback won. Stamp
            # the number on every entry; _watch_decline_confirm records what a
            # wait-for-pullback rule would have paid instead. Decide with data.
            "decline_at_entry": self._decline_deg(entry),
            "run_ext": entry.get("ext_c"), "ob_at_entry": entry.get("temp_now"),
            # ── weather-regime shadow measurement (gates nothing) ──
            # Every high-side loss so far had a physical explanation sitting
            # unread in the same METAR we already poll: Amsterdam 5h of drizzle
            # under a 1600ft ceiling, Chicago a BKN022 deck, Mexico City CB
            # outflow. Recorded here to test that against real outcomes —
            # WINNERS included. A first pass over 28 historical entries showed
            # the COMPOSITE score does not separate them (winners mean 0.79 vs
            # losers 0.68; Shanghai lost at a perfect 1.00), but the low-ceiling
            # flag alone was 0 winners / 2 losers. Too small to act on; exactly
            # why this logs instead of gating.
            "conditions": entry.get("conditions"),
            # ── anchored-ensemble shadow measurement (gates nothing) ──
            # 31 GFS members bias-corrected against the hours this station has
            # already reported today. The raw ensemble spread does NOT narrow
            # through the day (~9°F from 10:00 to 21:00 local, measured), so it
            # cannot serve as a lock signal; the LEVEL error can — on Chicago
            # 2026-07-27 all 31/31 members were reading 1.5–5.0° cold against
            # KMDW. The hypothesis under test is that a unanimous cold bias at
            # entry means the afternoon has room the climatology PMF isn't
            # pricing — i.e. the Chicago / Mexico City / Atlanta failure mode.
            "ensemble": entry.get("ensemble"),
        }
        with self._lock:
            self.open.append(pos)
            self.session["opened"] += 1
            self.session["staked_usd"] = round(self.session["staked_usd"] + cost, 2)
        self._persist(pos)
        cond = entry.get("conditions") or {}
        cond_txt = ""
        if cond.get("score") is not None:
            fl = []
            if cond.get("precip_now"):
                fl.append("precip")
            elif (cond.get("precip_recent_min") or 999) <= 90:
                fl.append(f"precip-{cond['precip_recent_min']:.0f}m")
            if (cond.get("ceiling_ft") or 99999) < 5000:
                fl.append(f"ceil{cond['ceiling_ft']:.0f}ft")
            if cond.get("convective"):
                fl.append("CB/TCU")
            if cond.get("trend") in ("BECMG", "TEMPO"):
                fl.append(cond["trend"])
            cond_txt = f" · wx {cond['score']:.2f}{' [' + ','.join(fl) + ']' if fl else ''}"
        ens = entry.get("ensemble") or {}
        ens_txt = ""
        if ens.get("n_members"):
            n = ens["n_members"]
            side = "cold" if ens["members_cold"] > ens["members_warm"] else "warm"
            agree = max(ens["members_cold"], ens["members_warm"])
            ens_txt = (f" · gfs {agree}/{n} {side} "
                       f"{ens['bias_med_c']:+.1f}C")
        self.on_log("◆", f"[weatherexec] {mode.upper()} ENTER {entry['city']} {entry['label']} "
                         f"@ {filled_c:.0f}c ×{shares} (p={entry['p']}, edge +{entry['edge_c']}c)"
                         f"{cond_txt}{ens_txt}")

    def _poly(self):
        """Lazily build and REUSE one PolyClient — avoids re-authenticating (and
        the couple-seconds latency that costs) on every live order."""
        if getattr(self, "_client", None) is None:
            import polymarket
            self._client = polymarket.PolyClient()
        return self._client

    def _entry_fee_usd(self, shares, filled_c):
        """Real entry-side taker fee in USD, added to cost_usd. Poly's real
        trades showed zero fee (verified against actual fills), so the base
        class is a no-op; Kalshi overrides this with its real quadratic fee."""
        return 0.0

    def _decline_gate_ok(self, entry):
        """Block entries where the reading is still SITTING at its running
        extreme instead of having pulled back from it.

        ORIGIN: a backtest over 26 settled Poly+Kalshi high entries on
        2026-07-26 found every loss to date had entered on a flat plateau
        (decline 0.0) while every entry after a >=1° pullback won. On that
        basis the gate went live on Kalshi only, with Poly as an ungated
        control.

        THAT PATTERN HAS SINCE BROKEN DOWN. Re-run against all 13 settled
        entries carrying a recorded decline (2026-07-27), only 1 of 4 losses
        entered at 0.0:

            Shanghai   2026-07-26  decline 0.0  −$7.92   ← gate catches
            Amsterdam  2026-07-26  decline 1.0  −$4.00   ← passes the gate
            Atlanta    2026-07-26  decline 2.0  −$7.39   ← passes the gate
            Miami      2026-07-27  decline 1.1  −$0.01   ← passes the gate

        At threshold 1.0 the gate blocks 4 of 9 winners (+$4.94) to avoid a
        single loser (−$7.92): net +$2.98, but that entire benefit rests on one
        trade. Remove Shanghai and the gate is net −$4.94, i.e. pure harm.
        Atlanta is the damning case — a 2° pullback, exactly the profile this
        gate is meant to bless, and a near-total loss.

        Kept because the user asked for it and the net is (barely) positive,
        but it is NOT the validated filter the origin backtest suggested. Treat
        the threshold as an open question, not a settled one, and re-check it
        as n grows. Set to 0 to disable per venue.

        Threshold is env-tunable per venue — WEATHER_DECLINE_GATE_DEG for Poly,
        KALSHI_WEATHER_DECLINE_GATE_DEG for Kalshi (see the subclass).
        """
        thr = self.DECLINE_GATE_DEG
        if thr <= 0:
            return True                # gate disabled for this venue
        d = self._decline_deg(entry)
        if d is None:
            return True                # missing data — never block on what we can't compute
        key = f"{entry['city']}|{entry['date']}|{entry.get('kind', 'high')}"
        if d < thr:
            # Log AND persist once per hold episode, not every ~90s cycle it
            # stays held — a real signal fired 5 identical lines in a row with
            # zero new information (2026-07-27). The persisted record still
            # gives us a durable snapshot of what the market was doing at the
            # moment we chose to wait, to weigh against what it cost by the
            # time (if ever) the pullback actually confirms.
            if key not in self._decline_held:
                self.on_log("→", f"[{self.LOG_TAG}] decline gate held {entry['city']} "
                                 f"{entry['label']} — still at extreme "
                                 f"(decline {d:+.1f}° < {thr}°), waiting for pullback")
                self._decline_held[key] = datetime.now(timezone.utc)
                self._persist({
                    "type": "decline_held", "key": key,
                    "city": entry["city"], "kind": entry.get("kind", "high"),
                    "label": entry["label"], "decline": d,
                    "ask_c": entry.get("ask_c"), "bid_c": entry.get("bid_c"),
                    "model_p": entry.get("p"), "edge_c": entry.get("edge_c"),
                    "run_ext": entry.get("ext_c"), "ob_now": entry.get("temp_now"),
                    "held_since": self._decline_held[key].isoformat(),
                })
            return False
        held_since = self._decline_held.pop(key, None)
        if held_since:
            mins = round((datetime.now(timezone.utc) - held_since).total_seconds() / 60, 1)
            self.on_log("→", f"[{self.LOG_TAG}] decline gate cleared {entry['city']} "
                             f"{entry['label']} — {mins:.0f}min after first held, "
                             f"decline now {d:+.1f}°, buying at {entry.get('ask_c')}c")
        return True

    @staticmethod
    def _decline_deg(entry_or_row):
        """Degrees the CURRENT reading has pulled back from the running extreme,
        in the market's unit. high: run_max − now (peak passed ⇒ positive).
        low: now − run_min (trough passed ⇒ positive). None if either missing."""
        ext = entry_or_row.get("ext_c")
        now = entry_or_row.get("temp_now") if "temp_now" in entry_or_row \
            else entry_or_row.get("temp_c")
        if ext is None or now is None:
            return None
        d = (ext - now) if entry_or_row.get("kind", "high") == "high" else (now - ext)
        return round(d, 1)

    def _watch_decline_confirm(self, rows):
        """Shadow measurement, part 2: for open positions that entered while the
        reading still sat AT its extreme (decline < 1°), record the moment a
        ≥1° pullback first confirms — and the bucket's ask at that moment.
        That ask is exactly what a wait-for-the-pullback rule would have paid
        instead of our real entry, i.e. the missing cost side of the rule.
        One record per position, persisted; gates nothing."""
        by_key = {f"{r['city']}|{r['date']}|{r['kind']}": r for r in rows}
        with self._lock:
            open_pos = list(self.open)
        for pos in open_pos:
            d0 = pos.get("decline_at_entry")
            if d0 is None or d0 >= 1.0 or pos.get("_decline_confirmed"):
                continue
            row = by_key.get(pos["key"])
            if not row:
                continue
            d_now = self._decline_deg(row)
            if d_now is None or d_now < 1.0:
                continue
            pos["_decline_confirmed"] = True
            bucket = next((b for b in row.get("buckets", [])
                           if b.get("label") == pos.get("label")), {})
            opened = datetime.fromisoformat(pos["opened"])
            mins = round((datetime.now(timezone.utc) - opened).total_seconds() / 60, 1)
            rec = {"type": "decline_confirmed", "key": pos["key"],
                   "city": pos["city"], "kind": pos.get("kind", "high"),
                   "decline_at_entry": d0, "decline_now": d_now,
                   "minutes_after_entry": mins,
                   "entry_c": pos.get("entry_c"),
                   "ask_now_c": bucket.get("ask_c"), "bid_now_c": bucket.get("bid_c"),
                   "ts": datetime.now(timezone.utc).isoformat()}
            self._persist(rec)
            ask = bucket.get("ask_c")
            self.on_log("→", f"[weatherexec] decline confirmed {pos['city']} "
                             f"{pos['label']} {mins:.0f}min after entry — waited "
                             f"entry would pay {ask if ask is not None else '—'}c "
                             f"vs our {pos.get('entry_c')}c")

    def _place_live(self, token_id, ask_c, shares, neg_risk=None):
        """Place a live FOK buy. Returns (filled_shares, avg_fill_price_cents);
        fill price is None if the fill response lacked amounts."""
        try:
            import polymarket
            client = self._poly()
            fee = polymarket.fetch_live_fee_bps(token_id) or 0
            filled = client.place_fok(token_id, int(round(ask_c)), float(shares), fee,
                                      neg_risk=neg_risk)
            return filled, getattr(client, "_last_fill_price_cents", None)
        except Exception as e:  # noqa: BLE001
            self.on_log("✗", f"[weatherexec] live order failed: {e}")
            return 0.0, None

    def _place_live_fak(self, token_id, ask_c, shares, neg_risk=None):
        """Place a live FAK buy — take whatever's available up to `shares`,
        partial fill is a normal outcome, not a failure. Used by
        _maximize_confirmed_win: that trade is already close to risk-free
        (window closed, outcome confirmed), so grabbing 4 of 7 available
        shares is still exactly as good a trade, just smaller — unlike a
        fresh entry, where all-or-nothing (_place_live/FOK) is deliberate.
        Base/Poly implementation; Kalshi overrides this to reuse _place_live,
        because Kalshi's only live mechanism (IOC) is already FAK-shaped."""
        try:
            import polymarket
            client = self._poly()
            fee = polymarket.fetch_live_fee_bps(token_id) or 0
            filled = client.place_fak(token_id, int(round(ask_c)), float(shares), fee,
                                      neg_risk=neg_risk)
            return filled, getattr(client, "_last_fill_price_cents", None)
        except Exception as e:  # noqa: BLE001
            self.on_log("✗", f"[weatherexec] live FAK order failed: {e}")
            return 0.0, None

    def _record_miss(self, entry, limit_c, shares):
        """A live FOK returned nothing. Re-read the book RIGHT NOW and persist the
        gap, so we can later separate a market that ran away (chase = buy losers)
        from a fill we lost by a cent (the real 'missed opportunity').

        gap_c = live best ask − our limit. Positive means the ask climbed above
        our limit (we'd have needed to pay more); depth_ok says the size we
        wanted is still there at all. The re-read is ~milliseconds after the
        kill, so it is the closest picture we get of why it died — but it is
        AFTER the fact, so treat it as diagnostic, not the exact fill book.
        """
        token = entry["token_yes"]
        asks = fetch_book_asks(token)
        bid = fetch_book_bid_c(token)
        now_ask = asks[0][0] if asks else None
        _, got, _ = vwap_for_size(asks, shares) if asks else (None, 0.0, None)
        gap_c = round(now_ask - limit_c, 2) if now_ask is not None else None
        rec = {
            "type": "miss", "ts": datetime.now(timezone.utc).isoformat(),
            "key": f"{entry['city']}|{entry['date']}|{entry.get('kind', 'high')}",
            "city": entry.get("city"),
            "label": entry.get("label"), "kind": entry.get("kind", "high"),
            "p": entry.get("p"), "edge_c": entry.get("edge_c"),
            "limit_c": round(limit_c, 2), "shares_wanted": shares,
            # book at the miss instant
            "now_ask_c": round(now_ask, 2) if now_ask is not None else None,
            "now_bid_c": round(bid, 2) if bid is not None else None,
            "gap_c": gap_c,                       # >0: ask climbed past our limit
            "depth_ok": bool(asks) and got + 1e-9 >= shares,
            "decline_at_entry": self._decline_deg(entry),  # shadow measurement
            "conditions": entry.get("conditions"),         # shadow measurement
            "ensemble": entry.get("ensemble"),             # shadow measurement
        }
        try:
            with open(MISS_LOG, "a") as f:
                f.write(json.dumps(rec) + "\n")
            self._misses += 1
        except Exception as e:  # noqa: BLE001
            log.warning("miss-log write failed: %s", e)
        g = f"gap {gap_c:+.1f}c" if gap_c is not None else "book gone"
        self.on_log("!", f"[weatherexec] LIVE FOK missed {entry['city']} "
                         f"{entry['label']} — limit {limit_c:.0f}c, now ask "
                         f"{'—' if now_ask is None else f'{now_ask:.0f}c'} ({g})")

    # ── real on-chain account (live truth, not modeled) ──────────────────────
    def _refresh_account(self):
        """Snapshot the REAL USDC balance so the dashboard shows actual P&L.

        equity = USDC + cost of still-open live positions (valuing open ones at
        cost, so tied-up capital isn't mistaken for a loss). Therefore
        real_pnl = equity − baseline is pure REALIZED profit, inclusive of
        everything the modeled ledger can miss: true fill prices, real fees,
        slippage. Cached to one read a minute.
        """
        if not (self.is_live or self._live_baseline is not None
                or any(p.get("mode") == "live" for p in self.open)):
            return
        now = time.time()
        if now - self._acct_ts < ACCT_REFRESH_SEC:
            return
        try:
            from py_clob_client_v2.clob_types import BalanceAllowanceParams, AssetType
            client = self._poly()
            bal = client._clob.get_balance_allowance(
                BalanceAllowanceParams(asset_type=AssetType.COLLATERAL))
            usdc = int(bal.get("balance", 0)) / 1_000_000.0
        except Exception as e:  # noqa: BLE001
            self.on_log("!", f"[weatherexec] account read failed: {e}")
            return
        self._acct_ts = now
        if self._live_baseline is None:
            self._live_baseline = usdc
            self._persist({"type": "baseline", "live_baseline_usd": usdc,
                           "ts": datetime.now(timezone.utc).isoformat()})
            self.on_log("◆", f"[weatherexec] live USDC baseline set = ${usdc:.2f}")
        with self._lock:
            live = [p for p in self.open if p.get("mode") == "live"]
            open_cost = sum(p.get("cost_usd", 0.0) for p in live)
            # MARK TO MARKET: a position is worth its current bid, not its cost.
            # Costing it would report a dead position at face value (Miami showed
            # +$1.55 against a true -$6.50). Fall back to cost only when unmarked.
            open_value = sum(
                (p["shares"] * p["mark_c"] / 100.0) if p.get("mark_c") is not None
                else p.get("cost_usd", 0.0)
                for p in live)
            unmarked = sum(1 for p in live if p.get("mark_c") is None)
        equity = usdc + open_value
        self._acct = {
            "usdc": round(usdc, 2),
            "open_cost": round(open_cost, 2),
            "open_value": round(open_value, 2),      # marked to the bid
            "unrealized": round(open_value - open_cost, 2),
            "unmarked": unmarked,                    # >0 => open_value part-guessed
            "equity": round(equity, 2),
            "baseline": round(self._live_baseline, 2),
            "real_pnl": round(equity - self._live_baseline, 2),
        }

    # ── manual closes (positions sold outside the bot) ───────────────────────
    def _reconcile_manual_closes(self):
        """A position can be sold by hand on Polymarket's UI (Warsaw 2026-07-25:
        a partial-fill remainder got closed manually while the bot still
        thought it was open, and the dashboard kept showing it — stale — until
        someone noticed). Catch this by checking the REAL on-chain share
        balance: if it's dropped to dust while our ledger still shows the
        position open, the shares are gone via a trade we didn't place. Pull
        the real trade history to reconstruct the actual proceeds rather than
        guessing, and settle it exactly like any other exit.
        """
        with self._lock:
            live_pos = [p for p in self.open if p.get("mode") == "live"]
        if not live_pos or not self.is_live:
            return
        try:
            client = self._poly()
        except Exception:  # noqa: BLE001
            return
        for pos in live_pos:
            token_id = pos.get("token_yes")
            if not token_id:
                continue
            held = client._held_shares(token_id)
            if held is None or held >= 1.0:
                continue        # can't read it, or it's still genuinely open
            try:
                r = requests.get(
                    "https://data-api.polymarket.com/trades",
                    params={"user": client._funder, "market": token_id, "limit": 50},
                    timeout=15)
                r.raise_for_status()
                trades = r.json()
            except Exception as e:  # noqa: BLE001
                self.on_log("!", f"[weatherexec] manual-close check failed "
                                 f"{pos['city']}: {e}")
                continue
            opened_ts = datetime.fromisoformat(pos["opened"]).timestamp()
            sells = [t for t in trades if t.get("side") == "SELL"
                     and t.get("timestamp", 0) >= opened_ts]
            sold_shares = round(sum(float(t["size"]) for t in sells), 4)
            proceeds = round(sum(float(t["size"]) * float(t["price"]) for t in sells), 2)
            if sold_shares <= 0:
                continue        # dust with no matching sell — leave it, don't guess
            pnl = round(proceeds - pos.get("cost_usd", 0.0), 2)
            avg_sold_c = round(proceeds / sold_shares * 100.0, 2) if sold_shares else None
            # This label is INFERRED, not observed — all we directly know is that
            # real shares vanished and real USDC arrived; WHY is a guess from the
            # price. A sale at/above our own take-profit threshold is almost
            # certainly our own TAKE-PROFIT order firing correctly on-chain while
            # the code path that was supposed to record it as such errored out
            # before writing the settle record (Shenzhen 2026-07-28: sold at 96c
            # against a 90c threshold, in the same minute as a run of "not enough
            # balance" order failures — the price match is too exact to be
            # coincidence, and there was no human at the keyboard). Below that
            # threshold there's no such signature to go on, so it stays
            # MANUAL-CLOSE — genuinely unexplained, not necessarily a person.
            if avg_sold_c is not None and avg_sold_c >= TAKE_PROFIT_BID_C:
                exit_tag = "TAKE-PROFIT"
                reason = (f"reconciled from real Polymarket trade history — sold at "
                          f"{avg_sold_c:.0f}c, at/above our {TAKE_PROFIT_BID_C:.0f}c "
                          f"take-profit threshold; almost certainly our own order "
                          f"whose settle record failed to write, not a manual close")
            else:
                exit_tag = "MANUAL-CLOSE"
                sold_txt = f"sold at {avg_sold_c:.0f}c" if avg_sold_c is not None else "sold"
                reason = (f"reconciled from real Polymarket trade history — {sold_txt}, "
                          f"below our take-profit threshold; genuinely unexplained by "
                          f"our own strategy logic (could still be a dead-exit we also "
                          f"failed to record, not necessarily a person)")
            rec = {"type": "settle", "key": pos["key"], "pos_id": self._pid(pos), "won": pnl >= 0,
                   "mode": pos.get("mode"),
                   "closed_early": True, "exit": exit_tag, "reason": reason,
                   "salvage_usd": proceeds, "sold_shares": sold_shares,
                   "sold_at_c": avg_sold_c, "gross_pnl": pnl, "fee_usd": 0.0,
                   "pnl_usd": pnl, "settled": datetime.now(timezone.utc).isoformat()}
            with self._lock:
                self.open = [p for p in self.open if self._pid(p) != self._pid(pos)]
                self.closed.append({**pos, **rec})
                self.closed = self.closed[-200:]
                self.session["settled"] += 1
                self.session["wins"] += 1 if pnl >= 0 else 0
                self.session["early_exits"] = self.session.get("early_exits", 0) + 1
                self.session["realized_pnl"] = round(self.session["realized_pnl"] + pnl, 2)
                self.session["realized_gross"] = round(self.session["realized_gross"] + pnl, 2)
                self.session["staked_usd"] = round(
                    max(0.0, self.session["staked_usd"] - pos.get("cost_usd", 0.0)), 2)
            self._persist(rec)
            self.on_log("✅" if pnl >= 0 else "✗",
                        f"[weatherexec] {exit_tag} (reconciled) {pos['city']} "
                        f"{pos['label']} — got ${proceeds:.2f} of "
                        f"${pos.get('cost_usd',0):.2f} ({pnl:+.2f})")

    # ── settlement (poll Gamma for resolutions) ──────────────────────────────
    def poll(self):
        self._refresh_account()
        self._reconcile_manual_closes()
        with self._lock:
            open_pos = list(self.open)
        if not open_pos:
            return
        # Gamma needs repeated condition_ids params (comma-joining returns [])
        # AND closed=true — the endpoint silently filters out closed markets by
        # default, which is precisely the state a settling position is in.
        ids = [p["condition_id"] for p in open_pos if p.get("condition_id")]
        try:
            r = requests.get(GAMMA_MARKETS,
                             params={"condition_ids": ids, "closed": "true"},
                             timeout=15)
            r.raise_for_status()
            markets = {m.get("conditionId"): m for m in r.json()}
        except Exception as e:  # noqa: BLE001
            self.on_log("!", f"[weatherexec] settle poll failed: {e}")
            return
        for pos in open_pos:
            m = markets.get(pos.get("condition_id"))
            if not m or m.get("umaResolutionStatus") != "resolved":
                continue
            try:
                prices = m.get("outcomePrices")
                prices = json.loads(prices) if isinstance(prices, str) else prices
                yes = float(prices[0])
            except (TypeError, ValueError, IndexError):
                continue
            won = yes >= 0.5
            gross = round(pos["shares"] * ((100 - pos["entry_c"]) if won else -pos["entry_c"]) / 100.0, 2)
            # Redemption at market resolution isn't a trade — no taker fee is
            # actually charged. taker_fee_c() here was a modeled 5% estimate
            # left over from before real Poly fills confirmed the true fee is
            # zero (see _entry_fee_usd); it was overstating losses on exactly
            # the positions that hit this natural-settlement path (Mexico City
            # -$7.89 recorded vs -$7.80 true, Chicago -$7.82 vs -$7.68 true).
            fee = 0.0
            net = round(gross - fee, 2)
            rec = {"type": "settle", "key": pos["key"], "pos_id": self._pid(pos), "won": won,
                   "mode": pos.get("mode"),
                   "gross_pnl": gross, "fee_usd": fee, "pnl_usd": net,
                   "settled": datetime.now(timezone.utc).isoformat()}
            with self._lock:
                self.open = [p for p in self.open if self._pid(p) != self._pid(pos)]
                self.closed.append({**pos, **rec})
                self.closed = self.closed[-200:]
                self.session["settled"] += 1
                self.session["wins"] += 1 if won else 0
                self.session["wins_held"] = self.session.get("wins_held", 0) + (1 if won else 0)
                self.session["realized_pnl"] = round(self.session["realized_pnl"] + net, 2)
                self.session["realized_gross"] = round(self.session["realized_gross"] + gross, 2)
                self.session["fees_paid"] = round(self.session["fees_paid"] + fee, 2)
                self.session["staked_usd"] = round(
                    max(0.0, self.session["staked_usd"] - pos.get("cost_usd", 0.0)), 2)
            self._persist(rec)
            self.on_log("✅" if won else "✗",
                        f"[weatherexec] SETTLE {pos['city']} {pos['date']} {pos['label']} "
                        f"{'WIN' if won else 'LOSS'} net {net:+.2f} USD (gross {gross:+.2f} − fee {fee:.2f}, "
                        f"model p was {pos['model_p']})")

    # ── state ────────────────────────────────────────────────────────────────
    def state(self):
        with self._lock:
            s = dict(self.session)
            s["win_rate"] = (s["wins"] / s["settled"]) if s["settled"] else None
            # calibration must be judged ONLY on positions held to resolution —
            # an early exit never reveals whether the bucket was actually right
            held = s["settled"] - s.get("early_exits", 0)
            s["settled_held"] = held
            s["win_rate_held"] = (s.get("wins_held", 0) / held) if held else None
            avg_p = ([p for p in (c.get("model_p") for c in self.closed) if p is not None])
            # PER-MODE breakdown — paper and live are different books and must be
            # counted separately, even though they share this ledger. Derived
            # from the position lists (each carries its own mode), so it is always
            # consistent with what's actually open/closed.
            by_mode = {}
            for m in ("live", "paper"):
                op = [p for p in self.open if p.get("mode") == m]
                cl = [c for c in self.closed if c.get("mode") == m]
                held_c = [c for c in cl if not c.get("closed_early")]
                by_mode[m] = {
                    "open": len(op),
                    "settled": len(cl),
                    "wins": sum(1 for c in cl if c.get("won")),
                    "settled_held": len(held_c),
                    "wins_held": sum(1 for c in held_c if c.get("won")),
                    "realized_pnl": round(sum(c.get("pnl_usd", 0.0) for c in cl), 2),
                    "staked_usd": round(sum(p.get("cost_usd", 0.0) for p in op), 2),
                }
            return {
                "mode": self.mode, "live": self.is_live, "env_armed": ENV_ARMED,
                "start_live": START_LIVE,   # boots live unattended? (see START_LIVE)
                "take_profit_fok": TAKE_PROFIT_FOK,
                "stake_usd": self.stake_usd, "max_open": MAX_OPEN, "session": s,
                "misses": self._misses,     # live FOKs that found nothing to fill
                "cooling_down": sorted(k for k, t in self._cooldown_until.items()
                                       if t > time.time()),
                "by_mode": by_mode,         # {live:{...}, paper:{...}}
                "account": self._acct,      # REAL on-chain USDC / equity / P&L

                "avg_model_p": round(sum(avg_p) / len(avg_p), 3) if avg_p else None,
                "open": [{k: p.get(k) for k in
                          ("mode", "city", "kind", "date", "label", "entry_c", "shares",
                           "cost_usd", "model_p", "edge_c", "opened", "mark_c",
                           "mark_stale", "health")}
                         for p in self.open],
                # Full settle history, most recent first — capped at the same
                # 200 self.closed keeps in memory. "exit_c" normalizes the two
                # settle paths: an early exit records the real average sale
                # price (sold_at_c); a natural settlement doesn't sell at all,
                # it resolves to 100c (won) or 0c (lost).
                "history": [{**{k: c.get(k) for k in
                                ("mode", "city", "kind", "date", "label", "entry_c",
                                 "shares", "cost_usd", "model_p", "won", "pnl_usd",
                                 "gross_pnl", "fee_usd", "exit", "closed_early",
                                 "settled")},
                             "exit_c": (c.get("sold_at_c") if c.get("sold_at_c") is not None
                                        else (100.0 if c.get("won") else 0.0))}
                            for c in self.closed[-100:]][::-1],
            }
