[Unit]
Description=Kalshi weather NEAR-LOCK — PAPER forward-test (isolated from the live Polymarket bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kalshi-poly
# Paper-only by construction: the runner forces WEATHER_LIVE=false before the
# executor imports, and asserts is_live is false at startup. Places no orders.
ExecStart=/opt/kalshi-poly/venv/bin/python scripts/run_kalshi_paper.py
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
# NOTE: the 512MB droplet has ~168MB free with the live bot running and NO swap.
# Add swap (or a bigger droplet) before enabling this unit, or an OOM could kill
# the LIVE bot too. See KALSHI_WEATHER_PLAN.md.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
