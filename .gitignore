# Secrets — NEVER commit these
.env
*.key
*.pem

# Runtime data
positions.json
*.jsonl
arb_trades.csv
*.log
# Live position state, rewritten continuously by the running bots. Tracking
# these means every deploy starts from a dirty tree and every pull is a
# potential merge conflict against real open positions.
*_state.json
__pycache__/
*.pyc
.pytest_cache/

# Local environment
venv/
.claude/

# Weather climatology (regenerate with scripts/build_weather_climo.py)
data/weather_climo.json

# Esports Phase-0 capture. Grows continuously and is raw observation, not
# source — the analysis scripts that consume it are what belong in git.
esports_data/

# Shadow feature capture for the weather confidence model. Raw observation,
# grows continuously; the scripts that consume it are what belong in git.
candidate_data/

# Belt-and-suspenders: ignore any .env variant (backups etc.)
.env*
*.pid
